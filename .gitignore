.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
dist/
*.egg-info/
.claude/

# lokaler Rust-Toolchain (siehe README) + Cargo-Build-Artefakte
.toolchain/
native/*/target/

# generierte Artefakte (scripts/build_dashboard.py)
build/

# Zwischenstaende langer Laeufe (scripts/long_run.py) -- die finalisierten
# data/*.json sind das Ergebnis, die Checkpoints nur der Weg dorthin
data/checkpoints/
data/long_run.log
data/STOP

# Rohdaten der grossen Laeufe bleiben lokal: die neun Regime des langen
# Laufs plus die fm-Regime sind zusammen ~400 MB, einzelne Dateien bis
# 82 MB (GitHub warnt ab 50 MB, blockt ab 100 MB). Fuer den Bericht zaehlt
# die reduzierte data/dashboard_data.json, nicht die Rohsaetze.
# Wirkt nur auf Neues -- die bereits getrackten kleinen Laeufe (5b, 8b,
# 6b_3s) bleiben im Repo und weiterhin versionierbar.
data/*.json
data/*.log
data/long_run_status.html
